<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- The line below hides the default app icon by replacing it with a transparent color -->
        <item name="android:windowSplashScreenAnimatedIcon">@color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/black</item>
    </style>
    
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
